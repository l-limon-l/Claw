<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Claw</AssemblyName>
    <RootNamespace>ClawInjector</RootNamespace>
    <Version>4.7.1</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <!-- Compile the built payload straight into the executable. Read at runtime via
       Assembly.GetManifestResourceStream("Claw.payload.js"). Build index.js first
       (npm run build) so this embeds the current release. -->
  <ItemGroup>
    <EmbeddedResource Include="..\index.js">
      <LogicalName>Claw.payload.js</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Optional Authenticode signing. Opt-in so a normal build without a cert still works:
       dotnet build -c Release -p:SignCert=path\to\cert.pfx -p:SignPassword=****
       (or -p:SignThumbprint=<installed cert thumbprint>). -->
  <Target Name="SignOutput" AfterTargets="Build"
          Condition="'$(SignCert)' != '' or '$(SignThumbprint)' != ''">
    <PropertyGroup>
      <_SignTimestamp>http://timestamp.digicert.com</_SignTimestamp>
      <_SignFileArgs Condition="'$(SignCert)' != ''">/f "$(SignCert)" /p "$(SignPassword)"</_SignFileArgs>
      <_SignFileArgs Condition="'$(SignThumbprint)' != ''">/sha1 $(SignThumbprint)</_SignFileArgs>
    </PropertyGroup>
    <Exec Command="signtool sign /fd SHA256 /td SHA256 /tr $(_SignTimestamp) $(_SignFileArgs) &quot;$(TargetPath)&quot;" />
  </Target>
</Project>
